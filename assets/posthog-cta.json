{
  "vars": {
    "posthogApiKey": "phc_Ju4K4bBXyI79wej0tzGRdMnJTYovgalsSVigfm0clOJ"
  },
  "requests": {
    "capture": "https://app.posthog.com/capture/"
  },
  "extraUrlParams": {
    "api_key": "${posthogApiKey}",
    "event": "cta_clicked",
    "distinct_id": "${clientId('posthog')}",
    "properties": {
      "site": "cheerselliot",
      "$process_person_profile": false
    }
  },
  "triggers": {
    "click on #contact trigger": {
      "on": "click",
      "selector": "#cta-contact",
      "request": "capture",
      "extraUrlParams": {
        "properties": { "cta": "contact" }
      }
    },
    "click on #portfolio trigger": {
      "on": "click",
      "selector": "#cta-portfolio",
      "request": "capture",
      "extraUrlParams": {
        "properties": { "cta": "portfolio" }
      }
    },
    "click on #phonechat trigger": {
      "on": "click",
      "selector": "#cta-phone-chat",
      "request": "capture",
      "extraUrlParams": {
        "properties": { "cta": "phone_chat" }
      }
    }
  },
  "transport": {
    "beacon": true,
    "xhrpost": true,
    "image": false,
    "useBody": true
  }
}
